@model IEnumerable<ProductCatalogMVC.Models.Product>

@{
    ViewBag.Title = "Product Catalog";
}

<h2>Product Catalog</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>₹@product.Price.ToString("0")</td>
                <td>@product.Category</td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = product.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
